APP_NAME="Hospital SAAS"
APP_ENV=production
APP_KEY=base64:+ynFRbDBwzmhIWV6E8IXmivh9Avk+6g+1Rq9voZCyso=
APP_DEBUG=false
APP_URL=https://your-app-subdomain.dockhosting.dev

LOG_CHANNEL=stack
LOG_LEVEL=error

# If using DockHosting PostgreSQL Database:
# DB_CONNECTION=pgsql
# DB_HOST=db-your-database-id
# DB_PORT=5432
# DB_DATABASE=hospital
# DB_USERNAME=postgres
# DB_PASSWORD=your_password

# If using DockHosting MySQL Database:
# DB_CONNECTION=mysql
# DB_HOST=db-your-database-id
# DB_PORT=3306
# DB_DATABASE=hospital
# DB_USERNAME=root
# DB_PASSWORD=your_password

# If using built-in SQLite:
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
